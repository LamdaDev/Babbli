# Required — your ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys).
# Needs access to: Agents, Text to Speech, Speech to Text, Voice Design, Sound Effects, Music.
ELEVENLABS_API_KEY=

# Optional overrides (defaults shown)
# LLM powering the NPCs inside ElevenAgents — low latency matters for voice.
# BABBLI_AGENT_LLM=claude-haiku-4-5
# LLM for ElevenAgents post-call analysis. Leave unset to use ElevenLabs' default (only some models are allowed here).
# BABBLI_ANALYSIS_LLM=gemini-2.5-flash
# Agent voice model (v3 conversational = most expressive; falls back to eleven_flash_v2_5 automatically).
# BABBLI_AGENT_TTS_MODEL=eleven_v3_conversational
# Model for replays, hint audio and native reference audio.
# BABBLI_TTS_MODEL=eleven_v3
# Scribe model for learner speech analysis.
# BABBLI_STT_MODEL=scribe_v2
# Where sessions, recordings, generated audio and the resource registry are stored.
# BABBLI_DATA_DIR=.babbli

# Use a specific existing voice instead of designing one (keys: HIROSHI, KENJI, CAMILLE,
# JULIEN, LUCIA, MATEO, COACH_JA, COACH_FR, COACH_ES), e.g.
# BABBLI_VOICE_HIROSHI=your_voice_id
